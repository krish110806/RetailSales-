# Google Cloud / BigQuery Configuration
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET_RAW=raw_data
BIGQUERY_DATASET_ANALYTICS=analytics
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service_account_key.json

# Airbyte Configuration
AIRBYTE_SERVER_URL=http://localhost:8000
AIRBYTE_WORKSPACE_ID=your-airbyte-workspace-id
AIRBYTE_API_KEY=your-airbyte-api-key

# Pipeline Settings
MAX_SAMPLE_RECORDS=1000
ENVIRONMENT=development
LOG_LEVEL=INFO
